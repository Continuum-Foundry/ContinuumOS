{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:original-desktop-os:package-manifest:1",
  "title": "Draft package manifest v1; semantic and security checks are separate",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1
    },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "kind": {
      "type": "string",
      "enum": [
        "kernel",
        "service",
        "app",
        "assets",
        "wasm"
      ]
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ]
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kernel_abi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "major": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "min_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "required": [
            "major",
            "min_minor"
          ]
        },
        "required_cpu_features": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
          }
        },
        "service_protocols": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "service_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
              },
              "major": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "min_minor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            },
            "required": [
              "service_id",
              "major",
              "min_minor"
            ]
          }
        }
      },
      "required": [
        "kernel_abi",
        "required_cpu_features",
        "service_protocols"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
          }
        },
        "optional": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
          }
        }
      },
      "required": [
        "required",
        "optional"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory_bytes": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 2147483648
        },
        "stack_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 16777216
        },
        "max_handles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        }
      },
      "required": [
        "memory_bytes",
        "stack_bytes",
        "max_handles"
      ]
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "L5"
          ]
        },
        "state_schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
        },
        "state_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": [
        "class",
        "state_schema",
        "state_version"
      ]
    }
  },
  "required": [
    "format_version",
    "package_id",
    "version",
    "source_revision",
    "kind",
    "files",
    "compatibility",
    "capabilities",
    "limits",
    "update"
  ]
}
