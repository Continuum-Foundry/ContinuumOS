{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:continuumos:draft:hosted-variants:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "variants",
    "capture_steps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "colors",
          "reduced_effects",
          "reduced_motion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "colors": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "surface",
              "panel",
              "text",
              "muted",
              "accent",
              "focus",
              "danger"
            ],
            "properties": {
              "surface": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "minItems": 4,
                "maxItems": 4
              },
              "panel": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "minItems": 4,
                "maxItems": 4
              },
              "text": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "minItems": 4,
                "maxItems": 4
              },
              "muted": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "minItems": 4,
                "maxItems": 4
              },
              "accent": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "minItems": 4,
                "maxItems": 4
              },
              "focus": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "minItems": 4,
                "maxItems": 4
              },
              "danger": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "minItems": 4,
                "maxItems": 4
              }
            }
          },
          "reduced_effects": {
            "type": "boolean"
          },
          "reduced_motion": {
            "type": "boolean"
          }
        }
      },
      "minItems": 5,
      "maxItems": 5
    },
    "capture_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "minItems": 5,
      "maxItems": 5
    }
  }
}
